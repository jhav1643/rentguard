# Base URL for the backend API. Leave empty to use the Vite /api proxy in dev,
# or the nginx /api proxy in the container.
VITE_API_URL=

# Dev-only: where the Vite dev server proxies /api to.
VITE_BACKEND_URL=http://localhost:5001

# Optional: display name shown in the header.
VITE_APP_NAME=RentGuard